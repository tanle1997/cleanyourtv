<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dialog_input_bg_focused" />
            <stroke android:width="2dp" android:color="@color/dialog_input_border_focused" />
            <corners android:radius="@dimen/dialog_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dialog_input_bg_normal" />
            <stroke android:width="1dp" android:color="@color/dialog_input_border_normal" />
            <corners android:radius="@dimen/dialog_corner_radius" />
        </shape>
    </item>
</selector>
