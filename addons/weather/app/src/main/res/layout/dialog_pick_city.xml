<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/dialog_bg"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pick_title"
        android:textColor="@color/dialog_title"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium" />

    <EditText
        android:id="@+id/cityNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/pick_hint"
        android:textColorHint="@color/dialog_text_hint"
        android:textColor="@color/dialog_text_white"
        android:textSize="15sp"
        android:singleLine="true"
        android:inputType="textCapWords"
        android:imeOptions="actionSearch"
        android:background="@drawable/edittext_tv_selector"
        android:padding="10dp"
        android:focusable="true" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pick_search"
            android:textColor="@color/btn_tv_text"
            android:background="@drawable/btn_tv_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/btnAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/auto_location"
            android:textColor="@color/btn_tv_text"
            android:background="@drawable/btn_tv_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <!-- Progress / Loading Status Text -->
    <TextView
        android:id="@+id/searchStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/dialog_text_accent"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <!-- Search Results Container (In-place results) -->
    <LinearLayout
        android:id="@+id/resultsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
